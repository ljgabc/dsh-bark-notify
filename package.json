{
  "name": "@local/bark-notify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bark push notifications: sends one push when DSH needs a decision (approval or question) or when a task/goal finishes, so the user can return in time.",
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.19.0 <4.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
